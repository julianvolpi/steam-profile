datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

model User {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now())
  steamId String @unique
  displayName String?
  avatar String?
  avatarMedium String?
  avatarFull String?
}
